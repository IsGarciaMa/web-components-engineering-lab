{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["tests/**/*.ts", "*.config.ts", "src/examples/**/*.ts"]
}
