---
import {
  domLessons,
  domChapterHref,
  domLessonHref,
} from '../../data/working-with-dom';
interface Props {
  current: string;
  end?: boolean;
}
const { current, end = false } = Astro.props;
const index = domLessons.findIndex((lesson) => lesson.slug === current);
if (index < 0) {
  throw new Error(`Lección desconocida: ${current}`);
}
const previous = domLessons[index - 1];
const next = domLessons[index + 1];
---

{
  end ? (
    <nav class="using-next not-content" aria-label="Continuar el capítulo">
      <a href={previous ? domLessonHref(previous.slug) : domChapterHref}>
        ← {previous ? previous.title : 'Mapa del capítulo'}
      </a>
      <a
        href={next ? domLessonHref(next.slug) : '/ejercicios/working-with-dom/'}
      >
        {next ? next.title : 'Resolver los ejercicios'} →
      </a>
    </nav>
  ) : (
    <nav
      class="using-lesson-nav not-content"
      aria-label="Lecciones de Working with the DOM"
    >
      <a class="text-link" href={domChapterHref}>
        ← Mapa del capítulo
      </a>
      <p class="eyebrow">
        LECCIÓN {index + 1} DE 8 · {domLessons[index]?.minutes} MIN ORIENTATIVOS
      </p>
      <details>
        <>
          <summary>Explorar las ocho lecciones</summary>
          <ol>
            {domLessons.map((lesson) => (
              <li>
                <a
                  href={domLessonHref(lesson.slug)}
                  aria-current={lesson.slug === current ? 'page' : undefined}
                >
                  {lesson.title}
                </a>
              </li>
            ))}
          </ol>
        </>
      </details>
    </nav>
  )
}
