---
import {
  definingLessons,
  definingChapterHref,
  definingLessonHref,
} from '../../data/defining-web-components';
interface Props {
  current: string;
  end?: boolean;
}
const { current, end = false } = Astro.props;
const index = definingLessons.findIndex((lesson) => lesson.slug === current);
if (index < 0) {
  throw new Error(`Lección desconocida: ${current}`);
}
const previous = definingLessons[index - 1];
const next = definingLessons[index + 1];
---

{
  end ? (
    <nav class="using-next not-content" aria-label="Continuar el capítulo">
      <a
        href={
          previous ? definingLessonHref(previous.slug) : definingChapterHref
        }
      >
        ← {previous ? previous.title : 'Mapa del capítulo'}
      </a>
      <a
        href={
          next
            ? definingLessonHref(next.slug)
            : '/ejercicios/defining-web-components/'
        }
      >
        {next ? next.title : 'Resolver los ejercicios'} →
      </a>
    </nav>
  ) : (
    <nav
      class="using-lesson-nav not-content"
      aria-label="Lecciones de Defining Web Components"
    >
      <a class="text-link" href={definingChapterHref}>
        ← Mapa del capítulo
      </a>
      <p class="eyebrow">
        LECCIÓN {index + 1} DE 9 · {definingLessons[index]?.minutes} MIN
        ORIENTATIVOS
      </p>
      <details>
        <>
          <summary>Explorar las nueve lecciones</summary>
          <ol>
            {definingLessons.map((lesson) => (
              <li>
                <a
                  href={definingLessonHref(lesson.slug)}
                  aria-current={lesson.slug === current ? 'page' : undefined}
                >
                  {lesson.title}
                </a>
              </li>
            ))}
          </ol>
        </>
      </details>
    </nav>
  )
}
