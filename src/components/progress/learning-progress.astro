---
import { foundationLesson } from '../../data/curriculum';
interface Props {
  lesson?: boolean;
  lessonId?: string;
}
const { lesson = false, lessonId } = Astro.props;
---

<lab-learning-progress
  lesson-id={lessonId ?? (lesson ? foundationLesson.id : undefined)}
></lab-learning-progress>
<noscript
  ><p>
    El progreso local opcional requiere JavaScript. Puedes recorrer todo el
    contenido sin activarlo.
  </p></noscript
>
<script>
  import './learning-progress';
</script>
